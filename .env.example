# CMI Gateway configuration (copy to .env, fill in real values)
# .env is git-ignored. NEVER commit credentials.

# --- CMI connection ---------------------------------------------------------
# Base URL of the CMI web server (LAN). Example value, adjust to your LAN.
CMI_BASE_URL=http://192.168.0.100
# TA CMI expert-mode Basic-Auth (from CMI settings / expert login) — check
# your CMI settings; the stock defaults are often "admin"/"admin".
CMI_USER=<cmi-user>
CMI_PASS=<cmi-pass>
# Git-host owner of this repo (used by scripts/pi_deploy_r1.sh when cloning
# the repo onto the Pi). Default "you" = the repo owner of your install.
CMI_GIT_USER=you
# Per-request timeout in seconds for CMI HTTP calls
CMI_TIMEOUT_SEC=15

# --- Rate limiting / polling ------------------------------------------------
# Minimum seconds between two /INCLUDE/api.cgi calls (CMI hard limit: 1/min)
CMI_API_INTERVAL_SEC=65
# Schematic polling interval in seconds
CMI_POLL_SEC=30
# CMI internal logging (/LOG) polling interval in seconds (S4N-LogPoll).
# The CMI appends one record every 10 s; 300 s (5 min) picks up ~30 new
# records per cycle. The poller is READ-ONLY (default CMI_LOG_CLEAR=false),
# so it does NOT keep the storekrit buffer empty by clearing -- that is a
# manual WinSol-Fetch-with-Delete decision.
CMI_LOG_POLL_SEC=300
# Whether the /LOG poller may send the state-mutating /LOG/clear.log to
# release the CMI's storekrit buffer. Default false = poller is READ-ONLY and
# NEVER clears: a clear deletes ALL buffer blocks INCLUDING the still-active
# block file that is not yet listed in the index, so a poller-issued clear
# destroys not-yet-ingested data (proven 2026-10-30: active block
# 00:00:05-15:16:48, ~5400 records, lost). Buffer release = manual
# WinSol-Fetch with Delete (user responsibility, see docs/cmi-log-protocol.md).
# true = legacy last-data-first clear gate (experimental; only to force-drain
# the CMI buffer through the gateway). Accepts true/1 and false/0 (any case).
CMI_LOG_CLEAR=false
# TTL (seconds) of the changer-resolver cache (default 24h)
CMI_CHANGER_TTL_SEC=86400

# --- Data / caches -----------------------------------------------------------
# Directory for file caches (changer cache). Git-ignored.
# CMI_DATA_DIR=/data

# --- History (S2-1) ----------------------------------------------------------
# Persistent history DB for live-poll samples (git-ignored).
# Separate from the WinSol Parquet store (data/winsol_pq) -- never write there.
# HISTORY_DB_PATH=/data/history.db
# Retention window in days; older measurements are pruned opportunistically.
HISTORY_RETENTION_DAYS=400
# How often (seconds) the retention cleanup runs.
HISTORY_RETENTION_CHECK_SEC=3600
# Only these live-polling sources are pruned by retention; historical sources
# (e.g. winsol) are kept permanently.
HISTORY_PRUNE_SOURCES=schematic,json

# --- WinSol Parquet store (on-demand history) ---------------------------------
# WinSol history is served ON DEMAND from the canonical Parquet store instead of
# being copied into the long store. Devices 'winsol:0/1/2' (Hive-partitioned,
# one zstd file per month: data/winsol_pq/YYYY/MM/YYYY-MM.parquet). The gateway
# reads it read-only; the original WinSol .log/.csv files are never touched.
# A missing/empty dir degrades cleanly (no winsol series).
# WINSOL_PARQUET_DIR=/data/winsol_pq

# --- CMI internal-logging Parquet store (S4N-LogParquet) ------------------------
# The CMI /LOG poller writes the live cmi-log history into its OWN wide Parquet
# store (same 71-column schema as winsol_pq: data/cmi_log_pq/YYYY/MM/...). The
# poller rewrites the in-progress month atomically every 5 min; finished months
# are frozen. The history route merges this store into the logical winsol:<N>
# series (winsol_pq wins on ts collisions). In the container point it into the
# writable ./data bind (image-layer defaults would not survive rebuilds):
# CMI_LOG_PARQUET_DIR=/data/cmi_log_pq

# --- L2-Engine / KI-Panel (S4N-UI-KI) -----------------------------------------
# L1-Feature-Store m1.3 (Hive YYYY/MM/*.parquet). Host-Default: data/features.
# Im Container: /data/features (ro-Bind-Mount innerhalb des rw ./data-Binds).
# L1_STORE_DIR=/data/features
# L1-Artefakt-Verzeichnis (cmi-brain-v003, LightGBM). Host-Default:
# models/cmi-brain/v003. Im Container: /srv/cmi/models/cmi-brain/v003
# (ro-Bind-Mount ./models).
# L1_MODEL_DIR=/srv/cmi/models/cmi-brain/v003
# TTL (Minuten) des in-memory-Caches für GET /api/v1/recommend (Default 5).
# Cache-Key = aktuelle volle Stunde; Treffer im TTL = kein Engine-Neulauf.
# RECOMMEND_CACHE_MIN=5

# --- S3-1 Write-Route /api/v1/change -------------------------------------------
# Audit-JSONL-Pfad: JEDE Change-Attempt (Success UND Fehler) wird eine Zeile
# {ts, adr, label, from, to, user, readback, applied, http_status} angehängt.
# Host-Default: data/audit/change.jsonl (schreibbarer ./data-Bind im Container).
# AUDIT_JSONL_PATH=/data/audit/change.jsonl

# --- Gateway security --------------------------------------------------------
# Bearer tokens for /api/v1/* (state + params).
# Read token: UI / external KI (DGX). Write token: S3-1 write route
# (POST /api/v1/change) + Key des Confirmation-Hashes (HMAC-SHA256).
# LEER lassen = Write-Route deaktiviert (503). Der UI zeigt "Anwenden"
# erst nach Abfrage des Write-Tokens (separater localStorage-Key).
# Generate e.g. with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
GATEWAY_READ_TOKEN=CHANGE_ME_read_token
GATEWAY_WRITE_TOKEN=CHANGE_ME_write_token
